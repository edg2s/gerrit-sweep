#!/bin/bash
set -e

# Check for --status flag
SHOW_STATUS=false
if [ "$1" = "--status" ]; then
	SHOW_STATUS=true
fi

# Check for --delete-abandoned flag
DELETE_ABANDONED=false
if [ "$1" = "--delete-abandoned" ]; then
	DELETE_ABANDONED=true
	SHOW_STATUS=true
fi

# Gerrit API base URL
GERRIT_API="https://gerrit.wikimedia.org/r"

# The Gerrit remote is not always called origin (e.g. git-review adds "gerrit")
REMOTE=$(git remote -v | awk '/gerrit\.wikimedia\.org.*\(fetch\)/ { print $1; exit }')
REMOTE=${REMOTE:-origin}

# Gerrit project name (e.g. mediawiki/core), if the remote is on Gerrit
PROJECT=$(git remote get-url "$REMOTE" 2>/dev/null | sed -nE 's#^.*(:29418|/r)/(.+)$#\2#p' | sed -E 's#(\.git)?/?$##')

# Try to get the default branch name (master/main)
DEFAULT_BRANCH=$(git symbolic-ref "refs/remotes/$REMOTE/HEAD" 2>/dev/null | sed "s@^refs/remotes/$REMOTE/@@")

if [ -z "$DEFAULT_BRANCH" ]; then
	DEFAULT_BRANCH='master'
fi

# Any copy of the default branch can be out of date, so check them all
MAIN_REFS=()
for REF in "refs/heads/$DEFAULT_BRANCH" $(git remote | sed "s@.*@refs/remotes/&/$DEFAULT_BRANCH@")
do
	if git rev-parse --verify -q "$REF" > /dev/null; then
		MAIN_REFS+=("$REF")
	fi
done

# Get the first Change-Id of each branch tip in one call
BRANCHES=()
IDS=()
while read -r BRANCH ID _
do
	if [ "$BRANCH" != "$DEFAULT_BRANCH" ] && [ -n "$ID" ]; then
		BRANCHES+=("$BRANCH")
		IDS+=("$ID")
	fi
done < <(git for-each-ref refs/heads --format='%(refname:lstrip=2) %(contents:trailers:key=Change-Id,valueonly,separator=%x20)')

# Find which of these Change-Ids are on the default branch in one pass
declare -A MERGED_IDS
if [ ${#IDS[@]} -gt 0 ] && [ ${#MAIN_REFS[@]} -gt 0 ]; then
	while read -r ID
	do
		MERGED_IDS[$ID]=1
	done < <(git log --format='%(trailers:key=Change-Id,valueonly)' "${MAIN_REFS[@]}" -- | grep -Fx -f <(printf '%s\n' "${IDS[@]}"))
fi

KEPT_BRANCHES=()
# Indexes of the branches to look up in Gerrit
LOOKUP=()
for i in "${!BRANCHES[@]}"
do
	if [ -n "${MERGED_IDS[${IDS[$i]}]}" ]; then
		git branch -D "${BRANCHES[$i]}"
	elif $SHOW_STATUS; then
		LOOKUP+=("$i")
	else
		KEPT_BRANCHES+=("${BRANCHES[$i]}")
	fi
done

# Query Gerrit for many changes per request. Gerrit rejects URLs over about
# 5000 characters, and each Change-Id adds about 52.
BATCH_SIZE=50
declare -A STATUSES
for (( START = 0; START < ${#LOOKUP[@]}; START += BATCH_SIZE ))
do
	QUERY=''
	for i in "${LOOKUP[@]:START:BATCH_SIZE}"
	do
		QUERY+="change:${IDS[$i]}+OR+"
	done
	if ! RESPONSE=$(curl -sf "$GERRIT_API/changes/?q=${QUERY%+OR+}&n=500"); then
		echo "Gerrit query failed, so some statuses are unknown" >&2
		continue
	fi
	# A Change-Id can be on many branches and projects. Ignore other projects,
	# and sort so that the change on the default branch is read last and wins.
	while read -r ID CHANGE_STATUS
	do
		STATUSES[$ID]=$CHANGE_STATUS
	done < <(sed 1d <<< "$RESPONSE" |
		jq -r --arg project "$PROJECT" --arg branch "$DEFAULT_BRANCH" \
			'map(select($project == "" or .project == $project)) | sort_by(.branch == $branch) | .[] | "\(.change_id) \(.status)"')
done

for i in "${LOOKUP[@]}"
do
	BRANCH=${BRANCHES[$i]}
	CHANGE_STATUS=${STATUSES[${IDS[$i]}]:-NOT FOUND}
	if [ "$DELETE_ABANDONED" = true ] && [ "$CHANGE_STATUS" = "ABANDONED" ]; then
		git branch -D "$BRANCH" | tr '\n' ' ' && echo "(ABANDONED)"
	else
		KEPT_BRANCHES+=("$BRANCH ($CHANGE_STATUS)")
	fi
done

if [ ${#KEPT_BRANCHES[@]} -gt 5 ]; then
	echo "Kept ${#KEPT_BRANCHES[@]} branches"
else
	for BRANCH in "${KEPT_BRANCHES[@]}"
	do
		echo "Kept branch $BRANCH"
	done
fi
