#!/bin/bash
set -e

# Check for --status flag
SHOW_STATUS=false
if [ "$1" = "--status" ]; then
	SHOW_STATUS=true
fi

# Check for --delete-abandoned flag
DELETE_ABANDONED=false
if [ "$1" = "--delete-abandoned" ]; then
	DELETE_ABANDONED=true
	SHOW_STATUS=true
fi

# Gerrit API base URL
GERRIT_API="https://gerrit.wikimedia.org/r"

# Try to get the default branch name (master/main)
DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')

if [ -z "$DEFAULT_BRANCH" ]; then
	DEFAULT_BRANCH='master'
fi

# Any copy of the default branch can be out of date, so check them all
MAIN_REFS=()
for REF in "refs/heads/$DEFAULT_BRANCH" $(git remote | sed "s@.*@refs/remotes/&/$DEFAULT_BRANCH@")
do
	if git rev-parse --verify -q "$REF" > /dev/null; then
		MAIN_REFS+=("$REF")
	fi
done

DEFAULT_BRANCH_CHANGE_IDS="$(git log "${MAIN_REFS[@]}" -- | grep Change-Id: )"

# Get the first Change-Id of each branch tip in one call
BRANCHES=()
IDS=()
while read -r BRANCH ID _
do
	if [ "$BRANCH" != "$DEFAULT_BRANCH" ] && [ -n "$ID" ]; then
		BRANCHES+=("$BRANCH")
		IDS+=("$ID")
	fi
done < <(git for-each-ref refs/heads --format='%(refname:lstrip=2) %(contents:trailers:key=Change-Id,valueonly,separator=%x20)')

KEPT_BRANCHES=()
for i in "${!BRANCHES[@]}"
do
	BRANCH=${BRANCHES[$i]}
	ID=${IDS[$i]}
	if echo "$DEFAULT_BRANCH_CHANGE_IDS" | grep "Change-Id: $ID" > /dev/null; then
		git branch -D "$BRANCH"
	else
		if $SHOW_STATUS; then
			CHANGE_STATUS=$(curl -s "$GERRIT_API/changes/$ID" | sed 1d | grep -o '"status":"[^"]*' | head -n 1 | cut -d '"' -f 4)
			if [ -z "$CHANGE_STATUS" ]; then
				CHANGE_STATUS="NOT FOUND"
			fi
			if [ "$DELETE_ABANDONED" = true ] && [ "$CHANGE_STATUS" = "ABANDONED" ]; then
				git branch -D "$BRANCH" | tr '\n' ' ' && echo "(ABANDONED)"
			else
				KEPT_BRANCHES+=("$BRANCH ($CHANGE_STATUS)")
			fi
		else
			KEPT_BRANCHES+=("$BRANCH")
		fi
	fi
done

if [ ${#KEPT_BRANCHES[@]} -gt 5 ]; then
	echo "Kept ${#KEPT_BRANCHES[@]} branches"
else
	for BRANCH in "${KEPT_BRANCHES[@]}"
	do
		echo "Kept branch $BRANCH"
	done
fi
